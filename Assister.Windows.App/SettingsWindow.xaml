<Window x:Class="Assister.Windows.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assister settings" Width="560" Height="740" ResizeMode="CanResize" MinWidth="500" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#101720" Foreground="#E7EDF5">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Connect your server" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="Use the Assister server origin and a token configured under RichClients:Clients on that server. HTTPS is required except for a private development LAN address." Foreground="#8B9AAF" TextWrapping="Wrap" Margin="0,7,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="SERVER ORIGIN" Foreground="#8B9AAF" FontSize="10" FontWeight="Bold" Margin="0,0,0,7"/>
            <TextBox x:Name="EndpointInput" Height="40" VerticalContentAlignment="Center" ToolTip="Example: http://10.0.0.197:5080"/>
        </StackPanel>
        <StackPanel Grid.Row="2">
            <TextBlock Text="CLIENT BEARER TOKEN" Foreground="#8B9AAF" FontSize="10" FontWeight="Bold" Margin="0,0,0,7"/>
            <PasswordBox x:Name="TokenInput" Height="40" Padding="12,9" Background="#111923" Foreground="#E7EDF5" BorderBrush="#2A3849" BorderThickness="1"/>
            <TextBlock Text="The token is stored in Windows Credential Manager." Foreground="#718197" FontSize="11" Margin="0,7,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,16,0,16">
        <StackPanel>
            <TextBlock Text="App updates" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock x:Name="UpdateVersionLabel" Foreground="#8B9AAF" Margin="0,0,0,8"/>
            <Button x:Name="CheckForUpdatesButton" Content="Check for updates" HorizontalAlignment="Left" Click="CheckForUpdates_Click"/>
            <TextBlock x:Name="UpdateStatusLabel" Text="Checks your saved server. Updates install after Settings closes and the chat is idle." Foreground="#8B9AAF" TextWrapping="Wrap" Margin="0,8,0,18"/>
            <TextBlock Text="Wake word" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <CheckBox x:Name="WakeWordEnabledInput" Content="Listen for a wake word locally" Foreground="#E7EDF5" Margin="0,0,0,12"/>
            <TextBlock Text="Start a new conversation after this many idle seconds" Foreground="#E7EDF5" TextWrapping="Wrap"/>
            <TextBox x:Name="WakeWordConversationTimeoutInput" MinHeight="40" VerticalContentAlignment="Center" Margin="0,6,0,6"/>
            <TextBlock Text="Default: 60 seconds. Use 0 to always continue the conversation. Applies to wake word activations; measured since the last message or finished response." Foreground="#8B9AAF" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"/>
            <TextBlock Text="Wake phrase: “light up”" Foreground="#E7EDF5" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SetupWakeWordButton" Content="Set up wake word engine" Click="SetupWakeWord_Click"/>
                <Button x:Name="CancelSetupButton" Content="Stop download" Visibility="Collapsed" Margin="8,0,0,0" Click="CancelSetup_Click"/>
            </StackPanel>
            <TextBlock x:Name="WakeWordSetupStatus" Foreground="#8B9AAF" TextWrapping="Wrap" Margin="0,8,0,10"/>
            <Expander Header="Advanced: custom model and keywords" Foreground="#8B9AAF" Margin="0,0,0,12">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Extracted sherpa-onnx KWS model folder"/>
                    <TextBox x:Name="WakeWordModelInput" Margin="0,6,0,10"/>
                    <TextBlock Text="Tokenized keyword file"/>
                    <TextBox x:Name="WakeWordKeywordsInput" Margin="0,6,0,8"/>
                </StackPanel>
            </Expander>
            <TextBlock Text="Wake detection stays local. Commands send automatically after one second of silence. Send finishes now; Cancel discards before submission. Command audio is uploaded to your server for transcription." TextWrapping="Wrap" Foreground="#8B9AAF" FontSize="11"/>
            <TextBlock x:Name="ErrorLabel" Foreground="#F0A5A5" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,9,0"/>
            <Button x:Name="SaveSettingsButton" Content="Save and connect" IsDefault="True" Background="#255548" BorderBrush="#357362" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
