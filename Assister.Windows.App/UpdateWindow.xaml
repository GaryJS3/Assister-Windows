<Window x:Class="Assister.Windows.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Updating Assister" Width="480" Height="260"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F7FA">
    <StackPanel Margin="32">
        <TextBlock Text="Updating Assister" FontSize="26" FontWeight="SemiBold" Foreground="#172A3A"/>
        <TextBlock x:Name="StatusLabel" Text="Preparing the update…" FontSize="17" Margin="0,20,0,12" TextWrapping="Wrap"/>
        <ProgressBar x:Name="UpdateProgress" Height="8" IsIndeterminate="True"/>
        <TextBlock x:Name="DetailLabel" Text="Assister will reopen automatically when the update is ready." FontSize="14" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#526575"/>
        <Button x:Name="CloseButton" Content="Close" Visibility="Collapsed" HorizontalAlignment="Right" Padding="20,8" Margin="0,12,0,0" Click="Close_Click"/>
    </StackPanel>
</Window>
