<Window x:Class="Assister.Windows.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assister" Height="820" Width="1280" MinHeight="620" MinWidth="900"
        FontSize="18" WindowStartupLocation="CenterScreen" Background="#0C1118" Foreground="#E7EDF5">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#121A24"/>
        <SolidColorBrush x:Key="PanelRaised" Color="#192331"/>
        <SolidColorBrush x:Key="Muted" Color="#8B9AAF"/>
        <SolidColorBrush x:Key="Accent" Color="#74D6B2"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E7EDF5"/><Setter Property="Background" Value="#202B39"/>
            <Setter Property="BorderBrush" Value="#2A3849"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,9"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#E7EDF5"/><Setter Property="Background" Value="#111923"/>
            <Setter Property="BorderBrush" Value="#2A3849"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/><Setter Property="CaretBrush" Value="#74D6B2"/>
        </Style>
    </Window.Resources>
    <Grid Background="#0C1118">
        <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#101720" BorderBrush="#202B38" BorderThickness="0,0,1,0">
            <DockPanel Margin="18" LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,5,0,34">
                        <Border Width="32" Height="32" CornerRadius="10" Background="#24483F"><TextBlock Text="A" Foreground="{StaticResource Accent}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="assister" FontSize="20" FontWeight="SemiBold" Margin="11,2,0,0"/>
                    </StackPanel>
                    <Button Content="＋   New conversation" HorizontalContentAlignment="Left" Background="#1B2A2C" BorderBrush="#2B5148" Click="NewConversation_Click"/>
                    <TextBlock Text="WORKSPACE" Foreground="{StaticResource Muted}" FontSize="14" FontWeight="Bold" Margin="8,28,0,10"/>
                    <Button Content="◉   Conversation" HorizontalContentAlignment="Left" Background="#1A2631" BorderBrush="#273749"/>
                    <Button Content="⚙   Settings" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Margin="0,7,0,0" Click="Settings_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="4,0,4,5">
                    <Border Height="1" Background="#25303D" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#E4A95C" VerticalAlignment="Center" x:Name="ConnectionDot"/>
                        <TextBlock x:Name="ConnectionLabel" Text="Not connected" Foreground="{StaticResource Muted}" Margin="9,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="EndpointLabel" Text="Configure a server in Settings" Foreground="#65758A" FontSize="15" Margin="17,6,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="WakeWordStatus" Text="Wake word off" Foreground="#8B9AAF" FontSize="15" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="#202B38" BorderThickness="0,0,0,1" Padding="26,0">
                <DockPanel VerticalAlignment="Center" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="CancelButton" Content="Cancel request" Padding="11,7" Visibility="Collapsed" Margin="0,0,8,0" Click="Cancel_Click"/>
                        <Button Content="Settings" Padding="11,7" Click="Settings_Click"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="ConversationTitle" Text="New conversation" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ProtocolLabel" Text="Connect to your Assister server to get started" FontSize="15" Foreground="{StaticResource Muted}" Margin="0,4,12,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                </DockPanel>
            </Border>
            <ScrollViewer x:Name="ConversationScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,20">
                <StackPanel x:Name="MessagesPanel" MaxWidth="1100" HorizontalAlignment="Stretch"/>
            </ScrollViewer>
            <Border Grid.Row="2" Background="#0C1118" Padding="24,12,24,22">
                <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">
                    <Border x:Name="TypedComposer" Background="#121A24" BorderBrush="#2A3849" BorderThickness="1" CornerRadius="13" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="MessageInput" Grid.Column="0" BorderThickness="0" Background="Transparent" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" MaxHeight="150" VerticalScrollBarVisibility="Auto" FontSize="22" VerticalContentAlignment="Center" KeyDown="MessageInput_KeyDown"/>
                            <Button x:Name="MicrophoneButton" Grid.Column="1" MinWidth="56" MinHeight="56" VerticalAlignment="Bottom" Margin="10,0,0,0"
                                    ToolTip="Record a voice command" AutomationProperties.Name="Record a voice command" Click="Microphone_Click">
                                <Viewbox Width="24" Height="28">
                                    <Canvas Width="24" Height="28">
                                        <Path Data="M 8,5 C 8,0 16,0 16,5 L 16,13 C 16,18 8,18 8,13 Z" Fill="#DFFAF0"/>
                                        <Path Data="M 4,12 L 4,14 C 4,24 20,24 20,14 L 20,12 M 12,22 L 12,27 M 7,27 L 17,27"
                                              Stroke="#DFFAF0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button x:Name="SendButton" Grid.Column="2" Content="Send  ↑" Background="#255548" BorderBrush="#357362" Foreground="#DFFAF0" VerticalAlignment="Bottom" Margin="10,0,0,0" Click="Send_Click"/>
                        </Grid>
                    </Border>
                    <Border x:Name="VoiceComposer" Visibility="Collapsed" Background="#172B28" BorderBrush="#357362" BorderThickness="1" CornerRadius="13" Padding="20">
                        <StackPanel>
                            <TextBlock x:Name="VoiceNotice" Text="Listening...." FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Focusable="False"/>
                            <TextBlock Text="Sends after one second of silence. Send finishes now; Cancel discards." Foreground="#8B9AAF" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,8,0,16"/>
                            <UniformGrid Columns="2">
                                <Button x:Name="VoiceSendButton" Content="Send" FontSize="22" MinHeight="64" Margin="0,0,8,0" Background="#255548" Click="VoiceSend_Click"/>
                                <Button x:Name="VoiceCancelButton" Content="Cancel" FontSize="22" MinHeight="64" Margin="8,0,0,0" Click="VoiceCancel_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <CheckBox x:Name="AutoplayResponses" Content="Automatically play new responses" IsChecked="True" MinHeight="44" VerticalContentAlignment="Center" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Unchecked="AutoplayResponses_Unchecked"/>
                    <TextBlock Text="Responses and execution details come directly from your Assister server." Foreground="#647489" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
